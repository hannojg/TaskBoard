{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "taskboard",
  "version": "0.9.1",
  "description": "A shared project and task board linked to Codex projects and chats.",
  "author": {
    "name": "Hanno"
  },
  "extensions": {
    "com.openai": {
      "requires_local_executor": true,
      "interface": {
        "displayName": "TaskBoard",
        "shortDescription": "Projects, tasks, and Codex chats",
        "longDescription": "A shared Kanban board with project and status views, Markdown descriptions, and agent-assisted Codex project and chat linking.",
        "developerName": "Hanno",
        "category": "Developer Tools",
        "capabilities": [
          "Read",
          "Write",
          "Interactive"
        ],
        "composerIcon": "./assets/icon.svg",
        "logo": "./assets/icon.svg",
        "defaultPrompt": [
          "Open my task board.",
          "Link a task to a Codex chat."
        ]
      }
    }
  }
}
